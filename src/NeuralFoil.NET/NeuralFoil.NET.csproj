<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NeuralFoil.NET</AssemblyName>
	  <AssemblyTitle>NeuralFoil.NET</AssemblyTitle>
    <Description>Port of NeuralFoil core inference to .NET.</Description>
	  <PackageId>NeuralFoil.NET</PackageId>
	  <RepositoryUrl>https://github.com/StuYarrow/NeuralFoil.NET</RepositoryUrl>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>NeuralFoil</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <Import Project="..\GlobalAssemblyInfo.csproj" />

  <ItemGroup>
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />

    <!-- Weights: copied locally for this repo's tests and packed for use by package consumers. -->
    <None Include="..\..\NeuralFoil\neuralfoil\nn_weights_and_biases\*.npz">
      <Link>nn_weights_and_biases\%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>build\nn_weights_and_biases</PackagePath>
    </None>

    <!-- Auto-imported by consuming projects; injects the weight-file copy without visible items. -->
    <None Include="build\NeuralFoil.NET.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

</Project>
